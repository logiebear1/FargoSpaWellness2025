@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="">Fargo Spa & Wellness</a>
            <button class="navbar-toggler" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="@(collapseNavMenu ? "collapse" : "") navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="services">Services</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="book">Book Appointment</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="testimonials">Testimonials</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="contact">Contact</NavLink></li>
                </ul>

                <AuthorizeView>
                    <Authorized>
                        <span class="navbar-text text-light me-3">Hello, @context.User.Identity?.Name!</span>
                        <a class="btn btn-outline-light btn-sm me-2" href="Identity/Account/Logout?returnUrl=%2F">Logout</a>

                        @if (context.User.IsInRole("Admin"))
                        {
                            <a class="btn btn-warning btn-sm" href="admin">Admin Dashboard</a>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-outline-light btn-sm me-2" href="Identity/Account/Register">Register</a>
                        <a class="btn btn-light btn-sm" href="Identity/Account/Login">Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @Body
    </main>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <p>© 2025 Fargo Spa & Wellness – All rights reserved</p>
    </footer>
</CascadingAuthenticationState>

@code {
    private bool collapseNavMenu = true;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
